# Copie para .env e preencha.

# Chave da API: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# IMAP. Gmail: imap.gmail.com | Outlook/Hotmail: outlook.office365.com | Yahoo: imap.mail.yahoo.com
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_USER=seu.email@gmail.com
# No Gmail use uma "senha de app" (https://myaccount.google.com/apppasswords), não a sua senha normal.
EMAIL_PASSWORD=
